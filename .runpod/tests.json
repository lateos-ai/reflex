{
  "tests": [
    {
      "name": "smoke-chat-completion",
      "input": {
        "messages": [{"role": "user", "content": "Say hello in exactly three words."}],
        "max_tokens": 16
      },
      "timeout": 120000
    },
    {
      "name": "smoke-chat-completion-stream",
      "input": {
        "messages": [{"role": "user", "content": "Say hello in exactly three words."}],
        "max_tokens": 16,
        "stream": true
      },
      "timeout": 120000
    },
    {
      "name": "smoke-classify",
      "input": {
        "prompt": "Review: The battery died after two days. Sentiment:",
        "labels": [" positive", " negative"]
      },
      "timeout": 120000
    },
    {
      "name": "smoke-classify-routing",
      "input": {
        "prompt": "I was charged twice for my subscription this month. Department:",
        "labels": [" billing", " tech_support", " sales", " legal"]
      },
      "timeout": 120000
    },
    {
      "name": "smoke-json-schema",
      "input": {
        "messages": [{"role": "user", "content": "Review: The battery died after two days. Extract the sentiment and the product part mentioned, as JSON."}],
        "max_tokens": 256,
        "response_format": {
          "type": "json_schema",
          "json_schema": {
            "name": "review",
            "strict": true,
            "schema": {
              "type": "object",
              "properties": {
                "sentiment": {"enum": ["positive", "negative", "neutral"]},
                "part": {"type": "string"}
              },
              "required": ["sentiment", "part"],
              "additionalProperties": false
            }
          }
        }
      },
      "timeout": 120000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA GeForce RTX 4090",
    "gpuCount": 1,
    "allowedCudaVersions": ["12.4", "12.8", "13.0", "13.2"]
  }
}
